% ---------------------------------------------------------- hyperlinks
\RequirePackage[hidelinks,bookmarksnumbered,pdfpagelabels]{hyperref}
\RequirePackage{bookmark}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\AtEndPreamble{%
  \crefname{defn}{Definition}{Definitions}%
  \crefname{result}{Result}{Results}%
  \crefname{wex}{Worked Example}{Worked Examples}%
  \crefname{kform}{Key Formula}{Key Formulas}%
  \crefname{pq}{Question}{Questions}%
  \crefname{theorem}{Theorem}{Theorems}%
  \crefname{proposition}{Proposition}{Propositions}%
  \crefname{lemma}{Lemma}{Lemmas}%
  \crefname{corollary}{Corollary}{Corollaries}%
  \crefname{rulebox}{Rule}{Rules}%
  \crefname{principle}{Principle}{Principles}}

% ------------------------------------------------------------- graphics
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,shapes.geometric,shapes.misc,
  decorations.pathreplacing,patterns,intersections,fit,backgrounds,
  matrix,shadows.blur}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\pgfplotsset{
  econ/.style={axis lines=left, xlabel near ticks, ylabel near ticks,
    every axis label/.append style={font=\small},
    tick label style={font=\footnotesize}, clip=false,
    axis line style={-{Stealth[length=2.2mm]}, thick}},
  stat/.style={axis lines=left, every axis label/.append style={font=\small},
    tick label style={font=\footnotesize},
    axis line style={-{Stealth[length=2.2mm]}}},
}
\tikzset{
  curve/.style={very thick},
  guide/.style={densely dashed, thin, inkgrey},
  pt/.style={circle, fill, inner sep=1.4pt},
  lab/.style={font=\small},
  mapnode/.style={draw=accent, very thick, rounded corners=3pt, fill=accentlight,
    align=center, font=\small\sffamily, inner sep=5pt, text width=#1},
  mapnode/.default=30mm,
  maparrow/.style={-{Stealth[length=2.6mm]}, thick, accent!80!black},
}

% -------------------------------------------------- headings and layout
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}

\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{1}

\titleformat{\chapter}[display]
  {\normalfont\color{accent}}
  {\begin{tikzpicture}[remember picture,overlay]
     \fill[accent] (current page.north west) rectangle
       ([yshift=-38mm]current page.north east);
   \end{tikzpicture}%
   \vspace*{-2mm}{\color{white}\sffamily\bfseries\Large\MakeUppercase{\chaptertitlename}\ \thechapter}}
  {16mm}
  {\sffamily\bfseries\Huge\raggedright}
  [\vspace{2mm}{\color{accent}\rule{\textwidth}{1.2pt}}]
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\color{accent}}
  {\begin{tikzpicture}[remember picture,overlay]
     \fill[accent] (current page.north west) rectangle
       ([yshift=-38mm]current page.north east);
   \end{tikzpicture}}
  {0mm}
  {\vspace*{8mm}\sffamily\bfseries\Huge\raggedright}
  [\vspace{2mm}{\color{accent}\rule{\textwidth}{1.2pt}}]
\titlespacing*{\chapter}{0pt}{-6mm}{10mm}

\titleformat{\section}
  {\normalfont\sffamily\bfseries\Large\color{accent}}
  {\thesection}{0.8em}{}
\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\large\color{accent!85!black}}
  {\thesubsection}{0.8em}{}
\titleformat{\subsubsection}
  {\normalfont\sffamily\bfseries\normalsize\color{inkgrey}}
  {\thesubsubsection}{0.8em}{}
\titleformat{\paragraph}[runin]
  {\normalfont\sffamily\bfseries\color{inkgrey}}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{5.5ex plus 1ex minus .2ex}{2.2ex plus .2ex}
\titlespacing*{\subsection}{0pt}{4ex plus 1ex minus .2ex}{1.6ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{3ex plus 1ex minus .2ex}{1.2ex plus .2ex}
\titlespacing*{\paragraph}{0pt}{1.8ex plus .5ex}{0.6em}

% part pages
\titleformat{\part}[display]
  {\normalfont\centering\color{accent}}
  {\sffamily\bfseries\LARGE\MakeUppercase{\partname}\ \thepart}
  {6mm}{\sffamily\bfseries\Huge}
\newcommand{\booktitle}{Textbook}
\newcommand{\bookshorttitle}{Textbook}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{accent!60}\hrule height\headrulewidth width\headwidth}}
\renewcommand{\chaptermark}[1]{\markboth{\ifnum\value{chapter}>0 \thechapter.\ \fi #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ \ #1}}
\fancyhead[L]{\small\sffamily\color{inkgrey}\nouppercase{\leftmark}}
\fancyhead[R]{\small\sffamily\color{accent}\bookshorttitle}
\fancyfoot[C]{\small\sffamily\color{inkgrey}\thepage}
\fancyfoot[R]{\scriptsize\sffamily\color{midgrey}\nouppercase{\rightmark}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small\sffamily\color{inkgrey}\thepage}}

% ToC appearance
\titlecontents{chapter}[2.4em]{\addvspace{1.2ex}\sffamily\bfseries\color{accent}}
  {\contentslabel{2.4em}}{}{\hfill\contentspage}[\addvspace{0.3ex}]
\titlecontents{section}[5.6em]{\small}
  {\contentslabel{3.2em}}{}{\titlerule*[0.7pc]{.}\contentspage}
\titlecontents{part}[0em]{\addvspace{3ex}\sffamily\bfseries\large\color{accent}}
  {\partname~\thecontentslabel\quad}{}{\hfill\contentspage}[\addvspace{1ex}]

% paragraphs
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.7ex plus 0.3ex minus 0.1ex}
\linespread{1.06}
\setlist{itemsep=0.25ex, topsep=0.6ex, parsep=0.3ex, leftmargin=1.6em}
\setlist[enumerate]{label=(\alph*), leftmargin=2.0em}
\captionsetup{font={small,sf}, labelfont={bf,color=accent}, width=0.92\textwidth,
  skip=6pt}
\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}
\allowdisplaybreaks[2]

% ------------------------------------------------------------ tcolorbox
\RequirePackage[most]{tcolorbox}
\tcbset{
  tbbase/.style={enhanced, breakable, sharp corners, boxrule=0pt,
    left=3.2mm, right=3.2mm, top=2.2mm, bottom=2.2mm,
    before skip=2.4ex plus 1ex, after skip=2.4ex plus 1ex,
    fonttitle=\sffamily\bfseries\small, coltitle=black,
    attach title to upper, after title={\par\smallskip},
    parbox=false},
  leftbar/.style 2 args={tbbase, colback=#2, borderline west={2.2pt}{0pt}{#1},
    title style={}, coltitle=#1},
}

% shared counters, reset each chapter
\newcounter{defn}[chapter]\renewcommand{\thedefn}{\thechapter.\arabic{defn}}
\newcounter{result}[chapter]\renewcommand{\theresult}{\thechapter.\arabic{result}}
\newcounter{wex}[chapter]\renewcommand{\thewex}{\thechapter.\arabic{wex}}
\newcounter{kform}[chapter]\renewcommand{\thekform}{\thechapter.\arabic{kform}}

% Definition:  \begin{definition}[Name]{label} ... \end{definition}
\NewDocumentEnvironment{definition}{o o}
 {\refstepcounter{defn}%
  \IfValueT{#2}{\label{#2}}%
  \begin{tcolorbox}[leftbar={defcol}{defbg},
     title={Definition \thedefn\IfValueT{#1}{\ \,(#1)}}]}
 {\end{tcolorbox}}

% Results: theorem / proposition / lemma / corollary / rule
\NewDocumentCommand{\newresultbox}{m m}{%
 \NewDocumentEnvironment{#1}{o o}
  {\refstepcounter{result}\IfValueT{##2}{\label[#1]{##2}}%
   \begin{tcolorbox}[leftbar={thmcol}{thmbg},
      title={#2 \theresult\IfValueT{##1}{\ \,(##1)}}]}
  {\end{tcolorbox}}}
\newresultbox{theorem}{Theorem}
\newresultbox{proposition}{Proposition}
\newresultbox{lemma}{Lemma}
\newresultbox{corollary}{Corollary}
\newresultbox{rulebox}{Rule}
\newresultbox{principle}{Principle}

% Worked example: \begin{example}[Title][label]
\NewDocumentEnvironment{example}{o o}
 {\refstepcounter{wex}\IfValueT{#2}{\label{#2}}%
  \begin{tcolorbox}[leftbar={excol}{exbg},
     title={Worked Example \thewex\IfValueT{#1}{\ \,\textendash\ #1}}]}
 {\end{tcolorbox}}
\newcommand{\solution}{\par\smallskip{\sffamily\bfseries\small\color{excol}Solution.}\enspace}
\newcommand{\answer}[1]{\par\smallskip{\sffamily\bfseries\small\color{excol}Answer:}\enspace #1}

% Notes, warnings, intuition, etc.
\NewDocumentEnvironment{note}{O{Note}}
 {\begin{tcolorbox}[leftbar={notecol}{notebg}, title={#1}]}{\end{tcolorbox}}
\NewDocumentEnvironment{intuition}{O{Intuition}}
 {\begin{tcolorbox}[leftbar={accent}{accentlight}, title={#1}]}{\end{tcolorbox}}
\NewDocumentEnvironment{warning}{O{Common mistake}}
 {\begin{tcolorbox}[leftbar={warncol}{warnbg}, title={\textcolor{warncol}{#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{examtip}{O{Recognising this in an exam}}
 {\begin{tcolorbox}[leftbar={examcol}{exambg}, title={\textcolor{examcol}{#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{sourcenote}{O{Note on the source material}}
 {\begin{tcolorbox}[leftbar={flagcol}{flagbg},
   title={\textcolor{flagcol}{\faIcon{exclamation-triangle}\ #1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{external}{O{Beyond the course materials}}
 {\begin{tcolorbox}[leftbar={extcol}{extbg}, title={\textcolor{extcol}{#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{why}{O{Why this matters}}
 {\begin{tcolorbox}[leftbar={accent}{white}, title={#1}]}{\end{tcolorbox}}

% CORE CONCEPT -- the strongest highlight
\NewDocumentEnvironment{core}{o}
 {\begin{tcolorbox}[enhanced, breakable, sharp corners, colback=corebg,
    colframe=corecol, boxrule=0.9pt, left=3.2mm, right=3.2mm, top=2mm, bottom=2mm,
    before skip=2.4ex plus 1ex, after skip=2.4ex plus 1ex, parbox=false,
    title={CORE CONCEPT\IfValueT{#1}{\ \ \textbar\ \ #1}},
    colbacktitle=corecol, coltitle=white, fonttitle=\sffamily\bfseries\small,
    toptitle=0.6mm, bottomtitle=0.6mm, left skip=0pt]}
 {\end{tcolorbox}}

% Prerequisites at the start of a chapter
\NewDocumentEnvironment{prerequisites}{}
 {\begin{tcolorbox}[leftbar={inkgrey}{softgrey}, title={Before you start: prerequisites}]}
 {\end{tcolorbox}}

% Key formula with the ten-point treatment.
%   \begin{keyformula}[Name][label]{display maths}
%     \fsymbols{...}\fmeaning{...} ...
%   \end{keyformula}
\NewDocumentEnvironment{keyformula}{o o m}
 {\refstepcounter{kform}\IfValueT{#2}{\label{#2}}%
  \begin{tcolorbox}[tbbase, colback=formbg, colframe=formcol, boxrule=0.6pt,
    borderline west={3pt}{0pt}{formcol}, coltitle=formcol,
    title={Key Formula \thekform\IfValueT{#1}{\ \,\textendash\ #1}}]
  \begin{equation*}\displaystyle #3\end{equation*}
  \begin{description}[style=nextline, leftmargin=0pt, labelindent=0pt,
     font=\sffamily\bfseries\small\color{formcol}, itemsep=0.5ex, parsep=0.2ex]}
 {\end{description}\end{tcolorbox}}
\newcommand{\fsymbols}{\item[Symbols]}
\newcommand{\fmeaning}{\item[What it means]}
\newcommand{\forigin}{\item[Where it comes from]}
\newcommand{\fuse}{\item[When to use it]}
\newcommand{\fexample}{\item[Step-by-step example]}
\newcommand{\fmistakes}{\item[Common mistakes]}
\newcommand{\frearrange}{\item[Rearrangements]}
\newcommand{\fchanges}{\item[Effect of changing the inputs]}
\newcommand{\fexam}{\item[How it appears in questions]}
\newcommand{\fconditions}{\item[Conditions and assumptions]}
\newcommand{\funits}{\item[Units]}

% Source reference tag, e.g. \src{Notes, Def.~4.18}
\newcommand{\src}[1]{\hfill{\scriptsize\sffamily\color{midgrey}[#1]}}
\newcommand{\srcin}[1]{{\scriptsize\sffamily\color{midgrey}[#1]}}

% Checklists
\newlist{checklist}{itemize}{2}
\setlist[checklist]{label=$\square$, leftmargin=1.8em, itemsep=0.15ex}
\newcommand{\tick}{\checkmark}

% Practice questions and solutions
\newcounter{pq}[chapter]
\renewcommand{\thepq}{\thechapter.\arabic{pq}}
\NewDocumentCommand{\pq}{o}{\par\needspace{4\baselineskip}\refstepcounter{pq}%
  \noindent{\sffamily\bfseries\color{accent}Question \thepq}%
  \IfValueT{#1}{\ {\sffamily\small\color{midgrey}[#1]}}\par\nobreak\smallskip}
\NewDocumentCommand{\pqsol}{m}{\par\needspace{4\baselineskip}%
  \noindent{\sffamily\bfseries\color{excol}Solution to Question #1}\par\nobreak\smallskip}

% Glossary entries
\NewDocumentCommand{\glossentry}{m m m}{%
  \par\needspace{3\baselineskip}\noindent{\sffamily\bfseries\color{accent}#1}\par\nobreak
  \begin{list}{}{\leftmargin=1.6em\topsep=0.2ex\itemsep=0.2ex\parsep=0pt}
  \item[]\textit{Definition.} #2
  \item[]\textit{In plain terms.} #3
  \end{list}\vspace{0.6ex}}

% Small helpers
\newcommand{\term}[1]{\textbf{\color{accent!85!black}#1}}
\newcommand{\eqtext}[1]{\quad\text{#1}\quad}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\E}{\mathrm{E}}
\newcommand{\Var}{\mathrm{Var}}
\newcommand{\Cov}{\mathrm{Cov}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\newcommand{\abs}[1]{\left\lvert #1\right\rvert}
\newcommand{\PP}{\mathbb{P}}

\RequirePackage{fontawesome5}

% A chapter opener paragraph style
\newenvironment{chapterintro}{\par\begingroup\large\itshape\color{inkgrey}}{\par\endgroup\medskip}

% Front-matter "how to use" icon key
\newcommand{\boxkey}[3]{%
  \tcbox[enhanced, sharp corners, boxrule=0pt, colback=#2, borderline west={2.2pt}{0pt}{#1},
    left=2mm, right=2mm, top=1mm, bottom=1mm, on line]{\sffamily\bfseries\small\textcolor{#1}{#3}}}

\endinput
