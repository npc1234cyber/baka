\definecolor{defcol}{HTML}{1F4E79}
\definecolor{defbg}{HTML}{EEF3FA}
\definecolor{thmcol}{HTML}{5B2C83}
\definecolor{thmbg}{HTML}{F4EFF9}
\definecolor{excol}{HTML}{2E6B30}
\definecolor{exbg}{HTML}{F0F7F0}
\definecolor{notecol}{HTML}{555555}
\definecolor{notebg}{HTML}{F5F5F5}
\definecolor{warncol}{HTML}{B03A2E}
\definecolor{warnbg}{HTML}{FBEFEE}
\definecolor{corecol}{HTML}{C0630A}
\definecolor{corebg}{HTML}{FFF5E8}
\definecolor{formcol}{HTML}{0B6E79}
\definecolor{formbg}{HTML}{EAF6F7}
\definecolor{flagcol}{HTML}{8A6D00}
\definecolor{flagbg}{HTML}{FFF9DB}
